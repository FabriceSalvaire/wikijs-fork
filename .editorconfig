# -*- mode: Conf -*-
# https://editorconfig.org/#file-format-details

root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
end_of_line = lf
insert_final_newline = true

[*.{jade,pug,md}]
trim_trailing_whitespace = false

[*].py
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4
